<Window x:Class="Proyecto_sql_base_de_datos.Presentacion.WpfConsultarCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proyecto_sql_base_de_datos.Presentacion"
        mc:Ignorable="d"
        Title="WpfConsultarCliente" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnConsultarCliente" Content="Consultar Cliente" HorizontalAlignment="Left" Height="81" Margin="392,115,0,0" VerticalAlignment="Top" Width="162" Click="Button_Click" FontSize="14" IsCancel="True"/>
        <TextBox x:Name="txtId" HorizontalAlignment="Left" Height="18" Margin="82,61,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160" IsEnabled="False"/>
        <TextBox x:Name="txtNombres"  HorizontalAlignment="Left" Margin="82,115,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160" />
        <TextBox x:Name="txtApellidos" HorizontalAlignment="Left" Margin="82,165,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160"/>
        <TextBox x:Name="txtDireccion" HorizontalAlignment="Left" Margin="82,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160"/>
        <TextBox x:Name="txtTelefono" HorizontalAlignment="Left" Margin="82,266,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160"/>
        <TextBox x:Name="txtCalificacion" HorizontalAlignment="Left" Margin="82,321,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160" IsEnabled="False"/>
        <TextBox x:Name="txtNumId" HorizontalAlignment="Left" Margin="390,61,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="162"/>
        <Label Content="Id cliente" HorizontalAlignment="Left" Margin="82,34,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.063,-0.122"/>
        <Label Content="Nombre" HorizontalAlignment="Left" Margin="82,89,0,0" VerticalAlignment="Top"/>
        <Label Content="Apellidos" HorizontalAlignment="Left" Margin="82,143,0,0" VerticalAlignment="Top"/>
        <Label Content="Dirección" HorizontalAlignment="Left" Margin="82,191,0,0" VerticalAlignment="Top"/>
        <Label Content="Telefono" HorizontalAlignment="Left" Margin="82,240,0,0" VerticalAlignment="Top"/>
        <Label Content="Calificación" HorizontalAlignment="Left" Margin="82,295,0,0" VerticalAlignment="Top"/>
        <Label Content="Ingrese el Num de identificación" HorizontalAlignment="Left" Margin="382,30,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnActualizar" Content="Actualizar Cliente" HorizontalAlignment="Left" Margin="392,204,0,0" VerticalAlignment="Top" Height="81" Width="162" IsCancel="True" FontSize="14" Click="btnActualizar_Click"/>
        <Button Content="Eliminar Cliente" HorizontalAlignment="Left" Height="83" Margin="392,295,0,0" VerticalAlignment="Top" Width="162" FontSize="14" Click="Button_Click_1"/>

    </Grid>
</Window>
